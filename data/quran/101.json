{
  "number": 101,
  "name_ar": "سُورَةُ القَارِعَةِ",
  "name_en": "Al-Qaari'a",
  "meaning": "The Calamity",
  "verses": 11,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "اَلۡقَارِعَةُۙ‏",
      "tl": "Al qaari'ah",
      "en": "The Striking Calamity -"
    },
    {
      "number": 2,
      "ar": "مَا الۡقَارِعَةُۚ‏",
      "tl": "Mal qaariah",
      "en": "What is the Striking Calamity?"
    },
    {
      "number": 3,
      "ar": "وَمَا٘ اَدۡرٰىكَ مَا الۡقَارِعَةُؕ‏",
      "tl": "Wa maa adraaka mal qaari'ah",
      "en": "And what can make you know what is the Striking Calamity?"
    },
    {
      "number": 4,
      "ar": "يَوۡمَ يَكُوۡنُ النَّاسُ كَالۡفَرَاشِ الۡمَبۡثُوۡثِۙ‏",
      "tl": "Yauma ya koonun naasu kal farashil mabthooth",
      "en": "It is the Day when people will be like moths, dispersed,"
    },
    {
      "number": 5,
      "ar": "وَتَكُوۡنُ الۡجِبَالُ كَالۡعِهۡنِ الۡمَنۡفُوۡشِؕ‏",
      "tl": "Wa ta koonul jibalu kal 'ihnil manfoosh",
      "en": "And the mountains will be like wool, fluffed up."
    },
    {
      "number": 6,
      "ar": "فَاَمَّا مَنۡ ثَقُلَتۡ مَوَازِيۡنُهٗۙ‏",
      "tl": "Fa-amma man thaqulat mawa zeenuh",
      "en": "Then as for one whose scales are heavy [with good deeds],"
    },
    {
      "number": 7,
      "ar": "فَهُوَ فِيۡ عِيۡشَةٍ رَّاضِيَةٍؕ‏",
      "tl": "Fahuwa fee 'ishatir raadiyah",
      "en": "He will be in a pleasant life."
    },
    {
      "number": 8,
      "ar": "وَاَمَّا مَنۡ خَفَّتۡ مَوَازِيۡنُهٗۙ‏",
      "tl": "Wa amma man khaffat mawa zeenuh",
      "en": "But as for one whose scales are light,"
    },
    {
      "number": 9,
      "ar": "فَاُمُّهٗ هَاوِيَةٌؕ‏",
      "tl": "Fa-ummuhu haawiyah",
      "en": "His refuge will be an abyss."
    },
    {
      "number": 10,
      "ar": "وَمَا٘ اَدۡرٰىكَ مَا هِيَهۡؕ‏",
      "tl": "Wa maa adraaka maa hiyah",
      "en": "And what can make you know what that is?"
    },
    {
      "number": 11,
      "ar": "نَارٌ حَامِيَةٌࣖ‏",
      "tl": "Naarun hamiyah",
      "en": "It is a Fire, intensely hot."
    }
  ]
}
