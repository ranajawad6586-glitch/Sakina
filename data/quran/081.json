{
  "number": 81,
  "name_ar": "سُورَةُ التَّكۡوِيرِ",
  "name_en": "At-Takwir",
  "meaning": "The Overthrowing",
  "verses": 29,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "اِذَا الشَّمۡسُ كُوِّرَتۡࣕۙ‏",
      "tl": "Izash shamsu kuwwirat",
      "en": "When the sun is wrapped up [in darkness]"
    },
    {
      "number": 2,
      "ar": "وَاِذَا النُّجُوۡمُ انۡكَدَرَتۡࣕۙ‏",
      "tl": "Wa izan nujoomun kadarat",
      "en": "And when the stars fall, dispersing,"
    },
    {
      "number": 3,
      "ar": "وَاِذَا الۡجِبَالُ سُيِّرَتۡࣕۙ‏",
      "tl": "Wa izal jibaalu suyyirat",
      "en": "And when the mountains are removed"
    },
    {
      "number": 4,
      "ar": "وَاِذَا الۡعِشَارُ عُطِّلَتۡࣕۙ‏",
      "tl": "Wa izal 'ishaaru 'uttilat",
      "en": "And when full-term she-camels are neglected"
    },
    {
      "number": 5,
      "ar": "وَاِذَا الۡوُحُوۡشُ حُشِرَتۡࣕۙ‏",
      "tl": "Wa izal wuhooshu hushirat",
      "en": "And when the wild beasts are gathered"
    },
    {
      "number": 6,
      "ar": "وَاِذَا الۡبِحَارُ سُجِّرَتۡࣕۙ‏",
      "tl": "Wa izal bihaaru sujjirat",
      "en": "And when the seas are filled with flame"
    },
    {
      "number": 7,
      "ar": "وَاِذَا النُّفُوۡسُ زُوِّجَتۡࣕۙ‏",
      "tl": "Wa izan nufoosu zuwwijat",
      "en": "And when the souls are paired"
    },
    {
      "number": 8,
      "ar": "وَاِذَا الۡمَوۡءٗدَةُ سُئِلَتۡࣕۙ‏",
      "tl": "Wa izal maw'oodatu su'ilat",
      "en": "And when the girl [who was] buried alive is asked"
    },
    {
      "number": 9,
      "ar": "بِاَيِّ ذَنۭۡ بٍ قُتِلَتۡۚ‏",
      "tl": "Bi ayyi zambin qutilat",
      "en": "For what sin she was killed"
    },
    {
      "number": 10,
      "ar": "وَاِذَا الصُّحُفُ نُشِرَتۡࣕۙ‏",
      "tl": "Wa izas suhufu nushirat",
      "en": "And when the pages are made public"
    },
    {
      "number": 11,
      "ar": "وَاِذَا السَّمَآءُ كُشِطَتۡࣕۙ‏",
      "tl": "Wa izas samaaa'u kushitat",
      "en": "And when the sky is stripped away"
    },
    {
      "number": 12,
      "ar": "وَاِذَا الۡجَحِيۡمُ سُعِّرَتۡࣕۙ‏",
      "tl": "Wa izal jaheemu su'-'irat",
      "en": "And when Hellfire is set ablaze"
    },
    {
      "number": 13,
      "ar": "وَاِذَا الۡجَنَّةُ اُزۡلِفَتۡࣕۙ‏",
      "tl": "Wa izal jannatu uzlifat",
      "en": "And when Paradise is brought near,"
    },
    {
      "number": 14,
      "ar": "عَلِمَتۡ نَفۡسٌ مَّا٘ اَحۡضَرَتۡؕ‏",
      "tl": "'Alimat nafsum maaa ahdarat",
      "en": "A soul will [then] know what it has brought [with it]."
    },
    {
      "number": 15,
      "ar": "فَلَا٘ اُقۡسِمُ بِالۡخُنَّسِۙ‏",
      "tl": "Falaaa uqsimu bil khunnas",
      "en": "So I swear by the retreating stars -"
    },
    {
      "number": 16,
      "ar": "الۡجَوَارِ الۡكُنَّسِۙ‏",
      "tl": "Al jawaaril kunnas",
      "en": "Those that run [their courses] and disappear -"
    },
    {
      "number": 17,
      "ar": "وَالَّيۡلِ اِذَا عَسۡعَسَۙ‏",
      "tl": "Wallaili izaa 'as'as",
      "en": "And by the night as it closes in"
    },
    {
      "number": 18,
      "ar": "وَالصُّبۡحِ اِذَا تَنَفَّسَۙ‏",
      "tl": "Wassubhi izaa tanaffas",
      "en": "And by the dawn when it breathes"
    },
    {
      "number": 19,
      "ar": "اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۙ‏",
      "tl": "Innahoo laqawlu rasoolin kareem",
      "en": "[That] indeed, the Qur'an is a word [conveyed by] a noble messenger"
    },
    {
      "number": 20,
      "ar": "ذِيۡ قُوَّةٍ عِنۡدَ ذِي الۡعَرۡشِ مَكِيۡنٍۙ‏",
      "tl": "Zee quwwatin 'inda zil 'arshi makeen",
      "en": "[Who is] possessed of power and with the Owner of the Throne, secure [in position],"
    },
    {
      "number": 21,
      "ar": "مُّطَاعٍ ثَمَّ اَمِيۡنٍؕ‏",
      "tl": "Mutaa'in samma ameen",
      "en": "Obeyed there [in the heavens] and trustworthy."
    },
    {
      "number": 22,
      "ar": "وَمَا صَاحِبُكُمۡ بِمَجۡنُوۡنٍۚ‏",
      "tl": "Wa maa saahibukum bimajnoon",
      "en": "And your companion is not [at all] mad."
    },
    {
      "number": 23,
      "ar": "وَلَقَدۡ رَاٰهُ بِالۡاُفُقِ الۡمُبِيۡنِۚ‏",
      "tl": "Wa laqad ra aahu bilufuqil mubeen",
      "en": "And he has already seen Gabriel in the clear horizon."
    },
    {
      "number": 24,
      "ar": "وَمَا هُوَ عَلَي الۡغَيۡبِ بِضَنِيۡنٍۚ‏",
      "tl": "Wa maa huwa 'alal ghaibi bidaneen",
      "en": "And Muhammad is not a withholder of [knowledge of] the unseen."
    },
    {
      "number": 25,
      "ar": "وَمَا هُوَ بِقَوۡلِ شَيۡطٰنٍ رَّجِيۡمٍۙ‏",
      "tl": "Wa maa huwa biqawli shaitaanir rajeem",
      "en": "And the Qur'an is not the word of a devil, expelled [from the heavens]."
    },
    {
      "number": 26,
      "ar": "فَاَيۡنَ تَذۡهَبُوۡنَؕ‏",
      "tl": "Fa ayna tazhaboon",
      "en": "So where are you going?"
    },
    {
      "number": 27,
      "ar": "اِنۡ هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَۙ‏",
      "tl": "In huwa illaa zikrul lil'aalameen",
      "en": "It is not except a reminder to the worlds"
    },
    {
      "number": 28,
      "ar": "لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّسۡتَقِيۡمَؕ‏",
      "tl": "Liman shaaa'a minkum ai yastaqeem",
      "en": "For whoever wills among you to take a right course."
    },
    {
      "number": 29,
      "ar": "وَمَا تَشَآءُوۡنَ اِلَّا٘ اَنۡ يَّشَآءَ اللّٰهُ رَبُّ الۡعٰلَمِيۡنَࣖ‏",
      "tl": "Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen",
      "en": "And you do not will except that Allah wills - Lord of the worlds."
    }
  ]
}
