{
  "number": 108,
  "name_ar": "سُورَةُ الكَوۡثَرِ",
  "name_en": "Al-Kawthar",
  "meaning": "Abundance",
  "verses": 3,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "اِنَّا٘ اَعۡطَيۡنٰكَ الۡكَوۡثَرَؕ‏",
      "tl": "Innaa a'taina kal kauthar",
      "en": "Indeed, We have granted you, [O Muhammad], al-Kawthar."
    },
    {
      "number": 2,
      "ar": "فَصَلِّ لِرَبِّكَ وَانۡحَرۡؕ‏",
      "tl": "Fa salli li rabbika wanhar",
      "en": "So pray to your Lord and sacrifice [to Him alone]."
    },
    {
      "number": 3,
      "ar": "اِنَّ شَانِئَكَ هُوَ الۡاَبۡتَرُࣖ‏",
      "tl": "Inna shani-aka huwal abtar",
      "en": "Indeed, your enemy is the one cut off."
    }
  ]
}
