{
  "number": 107,
  "name_ar": "سُورَةُ المَاعُونِ",
  "name_en": "Al-Maa'un",
  "meaning": "Almsgiving",
  "verses": 7,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "اَرَءَيۡتَ الَّذِيۡ يُكَذِّبُ بِالدِّيۡنِؕ‏",
      "tl": "Ara-aital lazee yu kazzibu bid deen",
      "en": "Have you seen the one who denies the Recompense?"
    },
    {
      "number": 2,
      "ar": "فَذٰلِكَ الَّذِيۡ يَدُعُّ الۡيَتِيۡمَۙ‏",
      "tl": "Fa zaalikal lazi yadu'ul-yateem",
      "en": "For that is the one who drives away the orphan"
    },
    {
      "number": 3,
      "ar": "وَلَا يَحُضُّ عَلٰي طَعَامِ الۡمِسۡكِيۡنِؕ‏",
      "tl": "Wa la ya huddu 'alaa ta'amil miskeen",
      "en": "And does not encourage the feeding of the poor."
    },
    {
      "number": 4,
      "ar": "فَوَيۡلٌ لِّلۡمُصَلِّيۡنَۙ‏",
      "tl": "Fa wai lul-lil mu salleen",
      "en": "So woe to those who pray"
    },
    {
      "number": 5,
      "ar": "الَّذِيۡنَ هُمۡ عَنۡ صَلَاتِهِمۡ سَاهُوۡنَۙ‏",
      "tl": "Al lazeena hum 'an salaatihim sahoon",
      "en": "[But] who are heedless of their prayer -"
    },
    {
      "number": 6,
      "ar": "الَّذِيۡنَ هُمۡ يُرَآءُوۡنَۙ‏",
      "tl": "Al lazeena hum yuraa-oon",
      "en": "Those who make show [of their deeds]"
    },
    {
      "number": 7,
      "ar": "وَيَمۡنَعُوۡنَ الۡمَاعُوۡنَࣖ‏",
      "tl": "Wa yamna'oonal ma'oon",
      "en": "And withhold [simple] assistance."
    }
  ]
}
