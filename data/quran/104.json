{
  "number": 104,
  "name_ar": "سُورَةُ الهُمَزَةِ",
  "name_en": "Al-Humaza",
  "meaning": "The Traducer",
  "verses": 9,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "وَيۡلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِۙ‏",
      "tl": "Wai lul-li kulli hu mazatil-lumaza",
      "en": "Woe to every scorner and mocker"
    },
    {
      "number": 2,
      "ar": "اِۨلَّذِيۡ جَمَعَ مَالًا وَّعَدَّدَهٗۙ‏",
      "tl": "Al-lazi jama'a maalaw wa'addadah",
      "en": "Who collects wealth and [continuously] counts it."
    },
    {
      "number": 3,
      "ar": "يَحۡسَبُ اَنَّ مَالَهٗ٘ اَخۡلَدَهٗۚ‏",
      "tl": "Yahsabu anna maalahu akhladah",
      "en": "He thinks that his wealth will make him immortal."
    },
    {
      "number": 4,
      "ar": "كَلَّا لَيُنۭۡ بَذَنَّ فِي الۡحُطَمَةِؗۖ‏",
      "tl": "Kalla layum ba zanna fil hutamah",
      "en": "No! He will surely be thrown into the Crusher."
    },
    {
      "number": 5,
      "ar": "وَمَا٘ اَدۡرٰىكَ مَا الۡحُطَمَةُؕ‏",
      "tl": "Wa maa adraaka mal-hutamah",
      "en": "And what can make you know what is the Crusher?"
    },
    {
      "number": 6,
      "ar": "نَارُ اللّٰهِ الۡمُوۡقَدَةُۙ‏",
      "tl": "Narul laahil-mooqada",
      "en": "It is the fire of Allah, [eternally] fueled,"
    },
    {
      "number": 7,
      "ar": "الَّتِيۡ تَطَّلِعُ عَلَي الۡاَفۡـِٕدَةِؕ‏",
      "tl": "Al latee tat tali'u 'alalafidah",
      "en": "Which mounts directed at the hearts."
    },
    {
      "number": 8,
      "ar": "اِنَّهَا عَلَيۡهِمۡ مُّؤۡصَدَةٌۙ‏",
      "tl": "Innaha 'alaihim moosada",
      "en": "Indeed, Hellfire will be closed down upon them"
    },
    {
      "number": 9,
      "ar": "فِيۡ عَمَدٍ مُّمَدَّدَةٍࣖ‏",
      "tl": "Fee 'amadim-mu mad dadah",
      "en": "In extended columns."
    }
  ]
}
