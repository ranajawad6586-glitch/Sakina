{
  "number": 86,
  "name_ar": "سُورَةُ الطَّارِقِ",
  "name_en": "At-Taariq",
  "meaning": "The Morning Star",
  "verses": 17,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "tl": "Wassamaaa'i wattaariq",
      "en": "By the sky and the night comer -"
    },
    {
      "number": 2,
      "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "tl": "Wa maaa adraaka mattaariq",
      "en": "And what can make you know what is the night comer?"
    },
    {
      "number": 3,
      "ar": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "tl": "Annajmus saaqib",
      "en": "It is the piercing star -"
    },
    {
      "number": 4,
      "ar": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ",
      "tl": "In kullu nafsil lammaa 'alaihaa haafiz",
      "en": "There is no soul but that it has over it a protector."
    },
    {
      "number": 5,
      "ar": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ",
      "tl": "Fal yanzuril insaanu mimma khuliq",
      "en": "So let man observe from what he was created."
    },
    {
      "number": 6,
      "ar": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ",
      "tl": "Khuliqa mim maaa'in daafiq",
      "en": "He was created from a fluid, ejected,"
    },
    {
      "number": 7,
      "ar": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "tl": "Yakhruju mim bainissulbi wat taraaa'ib",
      "en": "Emerging from between the backbone and the ribs."
    },
    {
      "number": 8,
      "ar": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ",
      "tl": "Innahoo 'alaa raj'ihee laqaadir",
      "en": "Indeed, Allah, to return him [to life], is Able."
    },
    {
      "number": 9,
      "ar": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "tl": "Yawma tublas saraaa'ir",
      "en": "The Day when secrets will be put on trial,"
    },
    {
      "number": 10,
      "ar": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ",
      "tl": "Famaa lahoo min quwwatinw wa laa naasir",
      "en": "Then man will have no power or any helper."
    },
    {
      "number": 11,
      "ar": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "tl": "Wassamaaa'i zaatir raj'",
      "en": "By the sky which returns [rain]"
    },
    {
      "number": 12,
      "ar": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "tl": "Wal ardi zaatis sad'",
      "en": "And [by] the earth which cracks open,"
    },
    {
      "number": 13,
      "ar": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ",
      "tl": "Innahoo laqawlun fasl",
      "en": "Indeed, the Qur'an is a decisive statement,"
    },
    {
      "number": 14,
      "ar": "وَمَا هُوَ بِٱلْهَزْلِ",
      "tl": "Wa maa huwa bil hazl",
      "en": "And it is not amusement."
    },
    {
      "number": 15,
      "ar": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا",
      "tl": "Innahum yakeedoona kaidaa",
      "en": "Indeed, they are planning a plan,"
    },
    {
      "number": 16,
      "ar": "وَأَكِيدُ كَيْدًۭا",
      "tl": "Wa akeedu kaidaa",
      "en": "But I am planning a plan."
    },
    {
      "number": 17,
      "ar": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "tl": "Famahhilil kaafireena amhilhum ruwaidaa",
      "en": "So allow time for the disbelievers. Leave them awhile."
    }
  ]
}
