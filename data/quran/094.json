{
  "number": 94,
  "name_ar": "سُورَةُ الشَّرۡحِ",
  "name_en": "Ash-Sharh",
  "meaning": "The Consolation",
  "verses": 8,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "اَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَۙ‏",
      "tl": "Alam nashrah laka sadrak",
      "en": "Did We not expand for you, [O Muhammad], your breast?"
    },
    {
      "number": 2,
      "ar": "وَوَضَعۡنَا عَنۡكَ وِزۡرَكَۙ‏",
      "tl": "Wa wa d'ana 'anka wizrak",
      "en": "And We removed from you your burden"
    },
    {
      "number": 3,
      "ar": "الَّذِيۡ٘ اَنۡقَضَ ظَهۡرَكَۙ‏",
      "tl": "Allazee anqada zahrak",
      "en": "Which had weighed upon your back"
    },
    {
      "number": 4,
      "ar": "وَرَفَعۡنَا لَكَ ذِكۡرَكَؕ‏",
      "tl": "Wa raf 'ana laka zikrak",
      "en": "And raised high for you your repute."
    },
    {
      "number": 5,
      "ar": "فَاِنَّ مَعَ الۡعُسۡرِ يُسۡرًاۙ‏",
      "tl": "Fa inna ma'al usri yusra",
      "en": "For indeed, with hardship [will be] ease."
    },
    {
      "number": 6,
      "ar": "اِنَّ مَعَ الۡعُسۡرِ يُسۡرًاؕ‏",
      "tl": "Inna ma'al 'usri yusra",
      "en": "Indeed, with hardship [will be] ease."
    },
    {
      "number": 7,
      "ar": "فَاِذَا فَرَغۡتَ فَانۡصَبۡۙ‏",
      "tl": "Fa iza faragh ta fansab",
      "en": "So when you have finished [your duties], then stand up [for worship]."
    },
    {
      "number": 8,
      "ar": "وَاِلٰي رَبِّكَ فَارۡغَبۡࣖ‏",
      "tl": "Wa ilaa rabbika far ghab",
      "en": "And to your Lord direct [your] longing."
    }
  ]
}
