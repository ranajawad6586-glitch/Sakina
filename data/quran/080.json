{
  "number": 80,
  "name_ar": "سُورَةُ عَبَسَ",
  "name_en": "Abasa",
  "meaning": "He frowned",
  "verses": 42,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "عَبَسَ وَتَوَلّٰ٘يۙ‏",
      "tl": "'Abasa wa tawallaa.",
      "en": "The Prophet frowned and turned away"
    },
    {
      "number": 2,
      "ar": "اَنۡ جَآءَهُ الۡاَعۡمٰيؕ‏",
      "tl": "An jaa-ahul 'a-maa",
      "en": "Because there came to him the blind man, [interrupting]."
    },
    {
      "number": 3,
      "ar": "وَمَا يُدۡرِيۡكَ لَعَلَّهٗ يَزَّكّٰ٘يۙ‏",
      "tl": "Wa maa yudreeka la'allahu yaz zakkaa.",
      "en": "But what would make you perceive, [O Muhammad], that perhaps he might be purified"
    },
    {
      "number": 4,
      "ar": "اَوۡ يَذَّكَّرُ فَتَنۡفَعَهُ الذِّكۡرٰيؕ‏",
      "tl": "Au yaz zak karu fatanfa 'ahuz zikraa.",
      "en": "Or be reminded and the remembrance would benefit him?"
    },
    {
      "number": 5,
      "ar": "اَمَّا مَنِ اسۡتَغۡنٰيۙ‏",
      "tl": "Amma manis taghnaa",
      "en": "As for he who thinks himself without need,"
    },
    {
      "number": 6,
      "ar": "فَاَنۡتَ لَهٗ تَصَدّٰيؕ‏",
      "tl": "Fa-anta lahu tasaddaa",
      "en": "To him you give attention."
    },
    {
      "number": 7,
      "ar": "وَمَا عَلَيۡكَ اَلَّا يَزَّكّٰيؕ‏",
      "tl": "Wa ma 'alaika allaa yaz zakka.",
      "en": "And not upon you [is any blame] if he will not be purified."
    },
    {
      "number": 8,
      "ar": "وَاَمَّا مَنۡ جَآءَكَ يَسۡعٰيۙ‏",
      "tl": "Wa amma man jaa-aka yas'a",
      "en": "But as for he who came to you striving [for knowledge]"
    },
    {
      "number": 9,
      "ar": "وَهُوَ يَخۡشٰيۙ‏",
      "tl": "Wahuwa yakhshaa,",
      "en": "While he fears [Allah],"
    },
    {
      "number": 10,
      "ar": "فَاَنۡتَ عَنۡهُ تَلَهّٰيۚ‏",
      "tl": "Fa-anta 'anhu talah haa.",
      "en": "From him you are distracted."
    },
    {
      "number": 11,
      "ar": "كَلَّا٘ اِنَّهَا تَذۡكِرَةٌۚ‏",
      "tl": "Kalla innaha tazkirah",
      "en": "No! Indeed, these verses are a reminder;"
    },
    {
      "number": 12,
      "ar": "فَمَنۡ شَآءَ ذَكَرَهٗۘ‏",
      "tl": "Faman shaa a zakarah",
      "en": "So whoever wills may remember it."
    },
    {
      "number": 13,
      "ar": "فِيۡ صُحُفٍ مُّكَرَّمَةٍۙ‏",
      "tl": "Fi suhufim mukar rama,",
      "en": "[It is recorded] in honored sheets,"
    },
    {
      "number": 14,
      "ar": "مَّرۡفُوۡعَةٍ مُّطَهَّرَةٍۙ‏",
      "tl": "Marfoo'atim mutah hara,",
      "en": "Exalted and purified,"
    },
    {
      "number": 15,
      "ar": "ۭ بِاَيۡدِيۡ سَفَرَةٍۙ‏",
      "tl": "Bi'aidee safara",
      "en": "[Carried] by the hands of messenger-angels,"
    },
    {
      "number": 16,
      "ar": "كِرَامٍۭ بَرَرَةٍؕ‏",
      "tl": "Kiraamim bararah.",
      "en": "Noble and dutiful."
    },
    {
      "number": 17,
      "ar": "قُتِلَ الۡاِنۡسَانُ مَا٘ اَكۡفَرَهٗؕ‏",
      "tl": "Qutilal-insanu maa akfarah.",
      "en": "Cursed is man; how disbelieving is he."
    },
    {
      "number": 18,
      "ar": "مِنۡ اَيِّ شَيۡءٍ خَلَقَهٗؕ‏",
      "tl": "Min aiyyi shai-in Khalaq",
      "en": "From what substance did He create him?"
    },
    {
      "number": 19,
      "ar": "مِنۡ نُّطۡفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗۙ‏",
      "tl": "Min nutfah; khalaqahu faqad-darah.",
      "en": "From a sperm-drop He created him and destined for him;"
    },
    {
      "number": 20,
      "ar": "ثُمَّ السَّبِيۡلَ يَسَّرَهٗۙ‏",
      "tl": "Thummas sabeela yas-sarah",
      "en": "Then He eased the way for him;"
    },
    {
      "number": 21,
      "ar": "ثُمَّ اَمَاتَهٗ فَاَقۡبَرَهٗۙ‏",
      "tl": "Thumma amatahu fa-aqbarah",
      "en": "Then He causes his death and provides a grave for him."
    },
    {
      "number": 22,
      "ar": "ثُمَّ اِذَا شَآءَ اَنۡشَرَهٗؕ‏",
      "tl": "Thumma iza shaa-a ansharah",
      "en": "Then when He wills, He will resurrect him."
    },
    {
      "number": 23,
      "ar": "كَلَّا لَمَّا يَقۡضِ مَا٘ اَمَرَهٗؕ‏",
      "tl": "Kalla lamma yaqdi maa amarah.",
      "en": "No! Man has not yet accomplished what He commanded him."
    },
    {
      "number": 24,
      "ar": "فَلۡيَنۡظُرِ الۡاِنۡسَانُ اِلٰي طَعَامِهٖ٘ۙ‏",
      "tl": "Falyanzuril insanu ilaa ta-amih",
      "en": "Then let mankind look at his food -"
    },
    {
      "number": 25,
      "ar": "اَنَّا صَبَبۡنَا الۡمَآءَ صَبًّاۙ‏",
      "tl": "Anna sabab nalmaa-a sabba.",
      "en": "How We poured down water in torrents,"
    },
    {
      "number": 26,
      "ar": "ثُمَّ شَقَقۡنَا الۡاَرۡضَ شَقًّاۙ‏",
      "tl": "Thumma sha qaqnal-arda shaqqa.",
      "en": "Then We broke open the earth, splitting [it with sprouts],"
    },
    {
      "number": 27,
      "ar": "فَاَنۭۡ بَتۡنَا فِيۡهَا حَبًّاۙ‏",
      "tl": "Fa ambatna feeha habba",
      "en": "And caused to grow within it grain"
    },
    {
      "number": 28,
      "ar": "وَّعِنَبًا وَّقَضۡبًاۙ‏",
      "tl": "Wa 'inabaw-wa qadba",
      "en": "And grapes and herbage"
    },
    {
      "number": 29,
      "ar": "وَّزَيۡتُوۡنًا وَّنَخۡلًاۙ‏",
      "tl": "Wa zaitoonaw wanakh la'",
      "en": "And olive and palm trees"
    },
    {
      "number": 30,
      "ar": "وَّحَدَآئِقَ غُلۡبًاۙ‏",
      "tl": "Wa hadaa-iqa ghulba",
      "en": "And gardens of dense shrubbery"
    },
    {
      "number": 31,
      "ar": "وَّفَاكِهَةً وَّاَبًّاۙ‏",
      "tl": "Wa faki hataw-wa abba.",
      "en": "And fruit and grass -"
    },
    {
      "number": 32,
      "ar": "مَّتَاعًا لَّكُمۡ وَلِاَنۡعَامِكُمۡؕ‏",
      "tl": "Mata'al-lakum wa li-an'amikum.",
      "en": "[As] enjoyment for you and your grazing livestock."
    },
    {
      "number": 33,
      "ar": "فَاِذَا جَآءَتِ الصَّآخَّةُؗ‏",
      "tl": "Faiza jaa-atis saakhah.",
      "en": "But when there comes the Deafening Blast"
    },
    {
      "number": 34,
      "ar": "يَوۡمَ يَفِرُّ الۡمَرۡءُ مِنۡ اَخِيۡهِۙ‏",
      "tl": "Yauma yafir-rul mar-u min akheeh",
      "en": "On the Day a man will flee from his brother"
    },
    {
      "number": 35,
      "ar": "وَاُمِّهٖ وَاَبِيۡهِۙ‏",
      "tl": "Wa ummihee wa abeeh",
      "en": "And his mother and his father"
    },
    {
      "number": 36,
      "ar": "وَصَاحِبَتِهٖ وَبَنِيۡهِؕ‏",
      "tl": "Wa sahi batihee wa baneeh.",
      "en": "And his wife and his children,"
    },
    {
      "number": 37,
      "ar": "لِكُلِّ امۡرِئٍ مِّنۡهُمۡ يَوۡمَئِذٍ شَاۡنٌ يُّغۡنِيۡهِؕ‏",
      "tl": "Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh",
      "en": "For every man, that Day, will be a matter adequate for him."
    },
    {
      "number": 38,
      "ar": "وُجُوۡهٌ يَّوۡمَئِذٍ مُّسۡفِرَةٌۙ‏",
      "tl": "Wujoo huny-yauma-izim-musfira;",
      "en": "[Some] faces, that Day, will be bright -"
    },
    {
      "number": 39,
      "ar": "ضَاحِكَةٌ مُّسۡتَبۡشِرَةٌۚ‏",
      "tl": "Dahi katum mustab shirah",
      "en": "Laughing, rejoicing at good news."
    },
    {
      "number": 40,
      "ar": "وَوُجُوۡهٌ يَّوۡمَئِذٍ عَلَيۡهَا غَبَرَةٌۙ‏",
      "tl": "Wa wujoohuy yauma-izin 'alaiha ghabar a",
      "en": "And [other] faces, that Day, will have upon them dust."
    },
    {
      "number": 41,
      "ar": "تَرۡهَقُهَا قَتَرَةٌؕ‏",
      "tl": "Tarhaquha qatarah.",
      "en": "Blackness will cover them."
    },
    {
      "number": 42,
      "ar": "اُولٰٓئِكَ هُمُ الۡكَفَرَةُ الۡفَجَرَةُࣖ‏",
      "tl": "Ulaa-ika humul-kafa ratul-fajarah.",
      "en": "Those are the disbelievers, the wicked ones."
    }
  ]
}
