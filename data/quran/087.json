{
  "number": 87,
  "name_ar": "سُورَةُ الأَعۡلَىٰ",
  "name_en": "Al-A'laa",
  "meaning": "The Most High",
  "verses": 19,
  "type": "meccan",
  "bismillah_inline": false,
  "ayahs": [
    {
      "number": 1,
      "ar": "سَبِّحِ اسۡمَ رَبِّكَ الۡاَعۡلَيۙ‏",
      "tl": "Sabbihisma Rabbikal A'laa",
      "en": "Exalt the name of your Lord, the Most High,"
    },
    {
      "number": 2,
      "ar": "الَّذِيۡ خَلَقَ فَسَوّٰيࣕۙ‏",
      "tl": "Allazee khalaqa fasawwaa",
      "en": "Who created and proportioned"
    },
    {
      "number": 3,
      "ar": "وَالَّذِيۡ قَدَّرَ فَهَدٰيࣕۙ‏",
      "tl": "Wallazee qaddara fahadaa",
      "en": "And who destined and [then] guided"
    },
    {
      "number": 4,
      "ar": "وَالَّذِيۡ٘ اَخۡرَجَ الۡمَرۡعٰيࣕۙ‏",
      "tl": "Wallazeee akhrajal mar'aa",
      "en": "And who brings out the pasture"
    },
    {
      "number": 5,
      "ar": "فَجَعَلَهٗ غُثَآءً اَحۡوٰيؕ‏",
      "tl": "Faja'alahoo ghusaaa'an ahwaa",
      "en": "And [then] makes it black stubble."
    },
    {
      "number": 6,
      "ar": "سَنُقۡرِئُكَ فَلَا تَنۡسٰ٘يۙ‏",
      "tl": "Sanuqri'uka falaa tansaaa",
      "en": "We will make you recite, [O Muhammad], and you will not forget,"
    },
    {
      "number": 7,
      "ar": "اِلَّا مَا شَآءَ اللّٰهُؕ اِنَّهٗ يَعۡلَمُ الۡجَهۡرَ وَمَا يَخۡفٰيؕ‏",
      "tl": "Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa",
      "en": "Except what Allah should will. Indeed, He knows what is declared and what is hidden."
    },
    {
      "number": 8,
      "ar": "وَنُيَسِّرُكَ لِلۡيُسۡرٰيۚۖ‏",
      "tl": "Wa nu-yassiruka lilyusraa",
      "en": "And We will ease you toward ease."
    },
    {
      "number": 9,
      "ar": "فَذَكِّرۡ اِنۡ نَّفَعَتِ الذِّكۡرٰيؕ‏",
      "tl": "Fazakkir in nafa'atizzikraa",
      "en": "So remind, if the reminder should benefit;"
    },
    {
      "number": 10,
      "ar": "سَيَذَّكَّرُ مَنۡ يَّخۡشٰيۙ‏",
      "tl": "Sa yazzakkaru maiyakhshaa",
      "en": "He who fears [Allah] will be reminded."
    },
    {
      "number": 11,
      "ar": "وَيَتَجَنَّبُهَا الۡاَشۡقَيۙ‏",
      "tl": "Wa yatajannabuhal ashqaa",
      "en": "But the wretched one will avoid it -"
    },
    {
      "number": 12,
      "ar": "الَّذِيۡ يَصۡلَي النَّارَ الۡكُبۡرٰيۚ‏",
      "tl": "Allazee yaslan Naaral kubraa",
      "en": "[He] who will [enter and] burn in the greatest Fire,"
    },
    {
      "number": 13,
      "ar": "ثُمَّ لَا يَمُوۡتُ فِيۡهَا وَلَا يَحۡيٰيؕ‏",
      "tl": "Summa laa yamootu feehaa wa laa yahyaa",
      "en": "Neither dying therein nor living."
    },
    {
      "number": 14,
      "ar": "قَدۡ اَفۡلَحَ مَنۡ تَزَكّٰيۙ‏",
      "tl": "Qad aflaha man tazakkaa",
      "en": "He has certainly succeeded who purifies himself"
    },
    {
      "number": 15,
      "ar": "وَذَكَرَ اسۡمَ رَبِّهٖ فَصَلّٰيؕ‏",
      "tl": "Wa zakaras ma Rabbihee fasallaa",
      "en": "And mentions the name of his Lord and prays."
    },
    {
      "number": 16,
      "ar": "بَلۡ تُؤۡثِرُوۡنَ الۡحَيٰوةَ الدُّنۡيَاۙ‏",
      "tl": "Bal tu'siroonal hayaatad dunyaa",
      "en": "But you prefer the worldly life,"
    },
    {
      "number": 17,
      "ar": "وَالۡاٰخِرَةُ خَيۡرٌ وَّاَبۡقٰيؕ‏",
      "tl": "Wal Aakhiratu khairunw wa abqaa",
      "en": "While the Hereafter is better and more enduring."
    },
    {
      "number": 18,
      "ar": "اِنَّ هٰذَا لَفِي الصُّحُفِ الۡاُوۡلٰيۙ‏",
      "tl": "Inna haazaa lafis suhu fil oolaa",
      "en": "Indeed, this is in the former scriptures,"
    },
    {
      "number": 19,
      "ar": "صُحُفِ اِبۡرٰهِيۡمَ وَمُوۡسٰيࣖ‏",
      "tl": "Suhufi Ibraaheema wa Moosaa",
      "en": "The scriptures of Abraham and Moses."
    }
  ]
}
